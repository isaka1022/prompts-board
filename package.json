{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "prompt-board",
  "title": "PromptBoard",
  "description": "Share, reuse, and run AI prompts seamlessly with your team",
  "icon": "🧠",
  "author": "your-name",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "supabaseUrl",
      "title": "Supabase URL",
      "description": "Your Supabase project URL",
      "type": "textfield",
      "required": true,
      "default": "https://ttdvuvlvnhefnuvnecvd.supabase.co"
    },
    {
      "name": "supabaseAnonKey",
      "title": "Supabase Anon Key",
      "description": "Your Supabase anonymous key",
      "type": "password",
      "required": true,
      "default": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR0ZHZ1dmx2bmhlZm51dm5lY3ZkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjE4MTMzNzksImV4cCI6MjA3NzM4OTM3OX0.LJ88Axy1XUQGaYhRa6ahHdJgXjiPoQr0EDugCrZ8POo"
    },
    {
      "name": "mcpBaseUrl",
      "title": "MCP Server URL",
      "description": "The base URL for the MCP server",
      "type": "textfield",
      "required": true,
      "default": "https://mcp-server-4mrd922n0-isaka1022s-projects.vercel.app"
    }
  ],
  "commands": [
    {
      "name": "login",
      "title": "Login",
      "description": "Login to PromptBoard with Google OAuth",
      "mode": "view"
    },
    {
      "name": "user-profile",
      "title": "User Profile",
      "description": "View your profile and logout from PromptBoard",
      "mode": "view"
    },
    {
      "name": "add-prompt",
      "title": "Add Prompt",
      "description": "Add a new prompt to PromptBoard",
      "mode": "view"
    },
    {
      "name": "search-prompt",
      "title": "Search Prompts",
      "description": "Search and run prompts from PromptBoard",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.64.0",
    "@raycast/utils": "^1.10.0",
    "@supabase/supabase-js": "^2.77.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^18.2.45",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
